"},{"word":"Cardiovascular","meaning":"心血管的","syn":"Heart-related","ex":"Exercise improves cardiovascular health."},{"word":"Obesity","meaning":"肥胖","syn":"Overweight","ex":"Obesity is a growing epidemic."},{"word":"Metabolism","meaning":"新陈代谢","syn":"Digestion","ex":"Exercise boosts your metabolism."},{"word":"Wellbeing","meaning":"幸福 / 健康","syn":"Wellness","ex":"Mental wellbeing is crucial."}]},"7":{"theme":"Wildlife Conservation","reading":{"title":"Protecting Biodiversity","text":"Deforestation and climate change threaten thousands of species. Conservation efforts are more critical than ever.","level":"B2","questions":[{"q":"What threatens species?","options":["Conservation","Deforestation","Zoos"],"a":"b"}]},"writing":{"prompt":"What measures should governments take to protect endangered species?"},"vocab":[{"word":"Biodiversity","meaning":"生物多样性","syn":"Variety of life","ex":"The Amazon has rich biodiversity."},{"word":"Endangered","meaning":"濒危的","syn":"Threatened","ex":"Pandas are no longer endangered."},{"word":"Habitat","meaning":"栖息地","syn":"Home","ex":"Deforestation destroys their habitat."},{"word":"Extinction","meaning":"灭绝","syn":"Dying out","ex":"Dinosaurs faced extinction."},{"word":"Conservation","meaning":"保护","syn":"Preservation","ex":"Conservation of water is important."}]}},"errorBank":[],"essays":{"current":""},"speakingInput":"","examDate":"2026-12-25","milestones":[{"name":"基础筑基 (A2)","status":"active","target":"掌握 2000 核心词 + 基础时态","deadline":"2026-06"},{"name":"能力爬坡 (B1)","status":"locked","target":"3500 词汇 + 复合句式","deadline":"2026-09"},{"name":"6.5 冲刺 (B2)","status":"locked","target":"真题模拟 + 写作逻辑优化","deadline":"2026-12"}],"chinglishPatterns":[{"regex":{},"name":"中式搭配","correction":"really like / like ... very much","explanation":"Very 不能修饰动词。"},{"regex":{},"name":"主谓一致","correction":"people are","explanation":"People 是复数。"},{"regex":{},"name":"词法混淆","correction":"There are","explanation":"存在句用 There。"},{"regex":{},"name":"基础语法","correction":"I am","explanation":"I 永远搭配 am。"}],"grammarQuestions":[{"id":1,"sentence":"My brother ________ (play) football every Sunday.","answer":"plays","explanation":"三单加 -s。"},{"id":2,"sentence":"They ________ (not like) cold weather.","answer":"do not like","explanation":"非三单否定用 do not。"},{"id":3,"sentence":"________ she ________ (live) in London?","answer":"Does live","explanation":"疑问句三单用 Does ... 动词原形。"},{"id":4,"sentence":"I ________ (be) a student at this school.","answer":"am","explanation":"I 永远搭配 am。"},{"id":5,"sentence":"Yesterday, I ________ (go) to the park.","answer":"went","explanation":"一般过去时：Go 的过去式是 went。"},{"id":6,"sentence":"We ________ (study) English right now.","answer":"are studying","explanation":"现在进行时：Be + V-ing。"},{"id":7,"sentence":"She ________ (have) breakfast at 8 AM daily.","answer":"has","explanation":"Have 的三单形式是 has。"},{"id":8,"sentence":"They ________ (watch) a movie last night.","answer":"watched","explanation":"过去式规则动词加 -ed。"},{"id":9,"sentence":"Water ________ (boil) at 100 degrees.","answer":"boils","explanation":"客观真理用一般现在时。"},{"id":10,"sentence":"He ________ (buy) a new car last month.","answer":"bought","explanation":"过去式不规则动词。"},{"id":11,"sentence":"Look! The sun ________ (shine).","answer":"is shining","explanation":"Look! 提示现在进行时"},{"id":12,"sentence":"I ________ (never be) to Tokyo.","answer":"have never been","explanation":"经验用现在完成时"},{"id":13,"sentence":"While I ________ (cook), the phone rang.","answer":"was cooking","explanation":"过去进行时作背景"},{"id":14,"sentence":"He ________ (already finish) his work.","answer":"has already finished","explanation":"already 提示现在完成时"},{"id":15,"sentence":"We ________ (wait) for 2 hours.","answer":"have been waiting","explanation":"for + 时间段，强调整体过程，用现在完成进行时"},{"id":16,"sentence":"They ________ (watch) TV right now.","answer":"are watching","explanation":"right now 提示现在进行时"},{"id":17,"sentence":"She ________ (not arrive) yet.","answer":"has not arrived","explanation":"yet 提示现在完成时"},{"id":18,"
+function getReadingEvidence(content, question) {
+    const answer = question.answerText || '';
+    const paragraphs = (content.text || '').match(/\([A-Z]\)[\s\S]*?(?=\n\n\([A-Z]\)|$)/g) || [];
+    const answerWords = normalizeEnglishText(answer)
+        .split(' ')
+        .filter(word => word.length >= 5)
+        .slice(0, 8);
+
+    if (!paragraphs.length || !answerWords.length) {
+        return '定位建议：回到原文找题目关键词和答案同义替换。';
+    }
+
+    const best = paragraphs.map((paragraph) => {
+        const normalized = normalizeEnglishText(paragraph);
+        const score = answerWords.filter(word => normalized.includes(word)).length;
+        return { paragraph, score };
+    }).sort((a, b) => b.score - a.score)[0];
+
+    if (!best || best.score === 0) {
+        return '定位建议：回到原文找题目关键词和答案同义替换。';
+    }
+
+    const label = (best.paragraph.match(/^\(([A-Z])\)/) || [])[1] || '?';
+    const compact = best.paragraph
+        .replace(/^\([A-Z]\)\s*/, '')
+        .replace(/\s+/g, ' ')
+        .slice(0, 180);
+    return `定位建议：Paragraph ${label}。依据片段：${compact}...`;
+}
